{
  "name": "@gopaylocal/react",
  "version": "0.0.1",
  "description": "React provider, hooks and components for GoPayLocal: purchasing power parity (PPP) discounts and localized prices.",
  "license": "MIT",
  "author": "RayLabs",
  "homepage": "https://docs.gopaylocal.com/react/installation/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RayLabsHQ/gopaylocal.git",
    "directory": "packages/react-sdk"
  },
  "bugs": {
    "url": "https://github.com/RayLabsHQ/gopaylocal/issues"
  },
  "keywords": [
    "ppp",
    "purchasing-power-parity",
    "parity-pricing",
    "regional-pricing",
    "localized-pricing",
    "discounts",
    "pricing",
    "gopaylocal",
    "react",
    "react-hooks"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepack": "pnpm run clean && pnpm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
