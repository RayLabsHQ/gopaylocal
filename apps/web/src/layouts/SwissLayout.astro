---
// Imported here rather than via `<style>@import ...</style>`: an Astro <style>
// block is scoped, which rewrites every Tailwind preflight selector to
// `button[data-astro-cid-…]` etc. Those resets then only match elements written
// directly in this file, so child components keep the UA defaults — grey
// buttonface behind the FAQ accordion, bulleted footer lists, content-box
// sizing, and doubled heading/paragraph margins. A frontmatter import emits it
// as a global stylesheet.
import '../styles/global.css';
import SwissHeader from '../components/landing/SwissHeader.astro';
import SwissFooter from '../components/landing/SwissFooter.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'PPP discounts that just work. Give your global customers fair, localized pricing.' } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content="https://gopaylocal.com/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://gopaylocal.com/og-image.png" />
    <link rel="canonical" href={Astro.url} />
    <title>{title}</title>
  </head>
  <body class="bg-bg text-text-primary antialiased font-sans">
    <SwissHeader />
    <main>
      <slot />
    </main>
    <SwissFooter />
  </body>
</html>
