---
import { Button } from "../ui/button";
import { pricingCards } from "@/lib/landing-data";
import RegionalProPrice from "./RegionalProPrice";
---

<section id="pricing" class="border-t border-border">
  <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:px-20">
    <div class="flex flex-col w-full text-center">
      <h2
        class="font-display text-3xl md:text-4xl font-semibold text-text-primary tracking-tight leading-tight"
      >
        The complete PPP toolkit, priced fairly
      </h2>
      <p class="mt-4 mx-auto max-w-prose text-base text-text-secondary leading-relaxed">
        Every feature on every plan. Start free, upgrade for one flat
        price, or run it on your own infrastructure.
      </p>
    </div>
    <!-- Plan cards: Free, Pro, Self-hosted -->
    <div class="mt-12 mx-auto max-w-5xl grid grid-cols-1 lg:grid-cols-3 items-stretch gap-4">
      {
        pricingCards.map((card) => (
          <div
            class:list={[
              // Subgrid: cards in the same row share the three row tracks
              // (header / buttons / features), so a wrapping subtitle can never
              // push one card's button out of line with its neighbours.
              "relative p-8 flex flex-col lg:grid lg:grid-rows-subgrid lg:row-span-3 bg-bg-surface border",
              card.highlighted ? "border-accent-500" : "border-border",
            ]}
          >
            {card.highlighted && (
              <span class="absolute top-4 right-4 bg-accent-500 text-white text-[11px] font-bold uppercase tracking-wider px-2 py-0.5">
                Recommended
              </span>
            )}
            <div>
              <p class="font-display text-base font-semibold text-text-primary">
                {card.name}
              </p>
              <p
                class="font-display text-5xl font-bold tracking-[-2px] tabular-nums mt-3 text-text-primary"
              >
                {card.price}
              </p>
              <p
                class="text-sm mt-3 leading-relaxed whitespace-pre-line text-text-secondary"
              >
                {card.subtitle}
              </p>
              {card.highlighted && <RegionalProPrice client:idle />}
            </div>

            <div class="mt-5">
              {card.highlighted ? (
                <Button
                  href={card.href}
                  variant="primary"
                  size="md"
                  className="w-full justify-center"
                  client:load
                >
                  {card.cta}
                </Button>
              ) : (
                <Button
                  href={card.href}
                  variant="secondary"
                  size="md"
                  className="w-full justify-center"
                  client:load
                >
                  {card.cta}
                </Button>
              )}
              {card.secondaryLink && (
                <a
                  href={card.secondaryLink.href}
                  class="mt-3 block text-center text-sm font-medium text-text-secondary underline underline-offset-4 hover:text-text-primary"
                >
                  {card.secondaryLink.label}
                </a>
              )}
            </div>

            <div class="mt-5 pt-4 space-y-2.5 border-t border-border">
              {card.features.map((f) => (
                <div class="flex items-center gap-2">
                  <svg
                    class="h-3.5 w-3.5 text-emerald-500 shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="2.5"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M4.5 12.75l6 6 9-13.5"
                    />
                  </svg>
                  <span class="text-sm text-text-secondary">{f}</span>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
