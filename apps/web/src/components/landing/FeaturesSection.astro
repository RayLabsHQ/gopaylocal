---
import { FeatureIcon } from '../ui/feature-icon';
import type { Feature } from '@/lib/landing-data';

interface Props {
  title: string;
  items: Feature[];
}

const { title, items } = Astro.props;
---

<section id="features" class="bg-bg">
  <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:px-20">
    <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tight text-text-primary whitespace-pre-line leading-[1.1]">
      {title}
    </h2>

    <div class="mt-12 grid grid-cols-1 md:grid-cols-3">
      {items.slice(0, 6).map((feature, index) => (
        <div
          class:list={[
            "p-10 border-border",
            index < 3 ? "border-b" : "",
            index === 3 || index === 4 ? "border-b md:border-b-0" : "",
            index % 3 !== 2 ? "md:border-r" : "",
          ]}
        >
          <div class="text-accent-500 mb-5">
            <FeatureIcon name={feature.icon} className="h-5 w-5" client:load />
          </div>
          <h3 class="font-display text-lg font-semibold leading-snug text-text-primary">{feature.title}</h3>
          <p class="mt-3 text-base text-text-secondary leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>