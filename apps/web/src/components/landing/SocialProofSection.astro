---
import type { ProofPoint } from '@/lib/landing-data';

interface Props {
  title: string;
  subtitle: string;
  proofPoints: ProofPoint[];
}

const { title, subtitle, proofPoints } = Astro.props;
---

<section class="bg-bg-inverted">
  <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:px-20">
    <h2 class="font-display text-3xl md:text-4xl font-semibold text-text-inverted tracking-tight whitespace-pre-line leading-[1.1]">
      {title}
    </h2>
    <p class="mt-4 max-w-prose text-base text-text-secondary leading-relaxed">{subtitle}</p>

    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
      {proofPoints.map((p) => (
        <div class="border border-border p-8">
          <p class="font-display text-lg font-semibold text-text-inverted leading-snug">{p.label}</p>
          <p class="mt-3 text-base text-text-secondary leading-relaxed">{p.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
