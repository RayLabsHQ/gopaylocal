---
import { faqItems } from '@/lib/landing-data';
---

<section class="border-t border-border bg-bg">
  <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:px-20">
    <h2 class="font-display text-3xl md:text-4xl font-semibold text-text-primary tracking-tight">Frequently asked questions</h2>
    <p class="mt-4 text-base text-text-secondary">Everything you need to know about purchasing power parity pricing.</p>

    <div class="mt-12">
      {faqItems.map((item, i) => (
        <div class:list={[
          "py-6",
          i < faqItems.length - 1 && "border-b border-border"
        ]}>
          <h3 class="font-display text-base font-semibold text-text-primary">{item.question}</h3>
          <p class="mt-3 text-sm text-text-secondary leading-relaxed max-w-3xl">{item.answer}</p>
        </div>
      ))}
    </div>
  </div>
</section>
