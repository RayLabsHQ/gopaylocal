---
// `badge` is the install method (SDK / Script / Plugin). It is surfaced as the
// link's title attribute — the visible label under each icon is the platform
// name, so the grid stays scannable.
type Platform = { name: string; slug: string; badge: string; href: string; invert?: boolean };

const codeFrameworks: Platform[] = [
  { name: "React", slug: "react", badge: "SDK", href: "https://docs.gopaylocal.com/react/installation" },
  {
    name: "Next.js",
    slug: "nextjs",
    badge: "SDK",
    href: "https://docs.gopaylocal.com/platforms/nextjs",
    invert: true,
  },
  {
    name: "Astro",
    slug: "astro",
    badge: "Script",
    href: "https://docs.gopaylocal.com/platforms/astro",
  },
  {
    name: "Remix",
    slug: "remix",
    badge: "Script",
    href: "https://docs.gopaylocal.com/platforms/remix",
    invert: true,
  },
  { name: "Vue", slug: "vue", badge: "Script", href: "https://docs.gopaylocal.com/js/installation" },
  { name: "Svelte", slug: "svelte", badge: "Script", href: "https://docs.gopaylocal.com/js/installation" },
  { name: "HTML", slug: "html", badge: "Script", href: "https://docs.gopaylocal.com/js/installation" },
];

const nocodeTools: Platform[] = [
  {
    name: "Shopify",
    slug: "shopify",
    badge: "Script",
    href: "https://docs.gopaylocal.com/platforms/shopify",
  },
  {
    name: "WordPress",
    slug: "wordpress",
    badge: "Script",
    href: "https://docs.gopaylocal.com/platforms/wordpress",
  },
  {
    name: "Webflow",
    slug: "webflow",
    badge: "Script",
    href: "https://docs.gopaylocal.com/platforms/webflow",
  },
  {
    name: "Framer",
    slug: "framer",
    badge: "Script",
    href: "https://docs.gopaylocal.com/platforms/framer",
  },
  {
    name: "Carrd",
    slug: "carrd",
    badge: "Script",
    href: "https://docs.gopaylocal.com/platforms/carrd",
  },
];
---

<section class="border-t border-border">
  <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:px-20">
    <h2
      class="font-display text-3xl md:text-4xl font-semibold tracking-tight leading-tight text-text-primary"
    >
      Works everywhere.
    </h2>
    <p class="mt-4 text-base text-text-secondary max-w-prose leading-relaxed">
      One script tag works on any website. SDKs for React and plain JavaScript,
      plus setup guides for popular site builders.
    </p>

    <div class="mt-10 md:mt-12 grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Frameworks & SDKs -->
      <div class="flex flex-col">
        <!-- Chart label -->
        <div class="flex items-end ml-6 mb-1">
          <svg
            class="overflow-visible shrink-0"
            width="50"
            height="20"
            viewBox="0 0 50 20"
            fill="none"
          >
            <circle cx="0" cy="20" r="4" fill="var(--accent)"></circle>
            <polyline
              points="0,20 16,4 50,4"
              stroke="var(--accent)"
              stroke-width="1"
              stroke-opacity="0.4"
              fill="none"></polyline>
          </svg>
          <span
            class="text-[11px] font-semibold uppercase tracking-wider text-text-muted ml-1 -translate-y-[8px]"
            >Frameworks &amp; SDKs</span
          >
        </div>
        <!-- Card -->
        <div class="border border-border p-6 md:p-8 flex-1">
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
            {
              codeFrameworks.map((f) => (
                <a
                  href={f.href}
                  title={`${f.name} — ${f.badge}`}
                  class="group flex flex-col items-center gap-3 border border-transparent p-4 no-underline transition-colors duration-200 hover:border-accent-500 hover:bg-bg-surface"
                >
                  <img
                    src={`/logos/${f.slug}.svg`}
                    alt=""
                    class:list={["h-8 w-8 shrink-0 object-contain", f.invert && "brightness-0 invert"]}
                  />
                  <span class="text-sm font-medium text-text-secondary text-center transition-colors duration-200 group-hover:text-text-primary">
                    {f.name}
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <!-- No-code & Low-code -->
      <div class="flex flex-col">
        <!-- Chart label -->
        <div class="flex items-end ml-6 mb-1">
          <svg
            class="overflow-visible shrink-0"
            width="50"
            height="20"
            viewBox="0 0 50 20"
            fill="none"
          >
            <circle cx="0" cy="20" r="4" fill="var(--accent)"></circle>
            <polyline
              points="0,20 16,4 50,4"
              stroke="var(--accent)"
              stroke-width="1"
              stroke-opacity="0.4"
              fill="none"></polyline>
          </svg>
          <span
            class="text-[11px] font-semibold uppercase tracking-wider text-text-muted ml-1 -translate-y-[8px]"
            >No-code &amp; Low-code</span
          >
        </div>
        <!-- Card -->
        <div class="border border-border p-6 md:p-8 flex-1">
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
            {
              nocodeTools.map((f) => (
                <a
                  href={f.href}
                  title={`${f.name} — ${f.badge}`}
                  class="group flex flex-col items-center gap-3 border border-transparent p-4 no-underline transition-colors duration-200 hover:border-accent-500 hover:bg-bg-surface"
                >
                  <img
                    src={`/logos/${f.slug}.svg`}
                    alt=""
                    class:list={["h-8 w-8 shrink-0 object-contain", f.invert && "brightness-0 invert"]}
                  />
                  <span class="text-sm font-medium text-text-secondary text-center transition-colors duration-200 group-hover:text-text-primary">
                    {f.name}
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
