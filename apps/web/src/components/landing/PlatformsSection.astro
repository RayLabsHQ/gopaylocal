---
const codeFrameworks = [
  { name: 'React', slug: 'react', badge: 'SDK', href: '/docs/react' },
  { name: 'Next.js', slug: 'nextjs', badge: 'SDK', href: '/docs/platforms/nextjs' },
  { name: 'Astro', slug: 'astro', badge: 'Script', href: '/docs/platforms/astro' },
  { name: 'Remix', slug: 'remix', badge: 'Script', href: '/docs/platforms/remix' },
  { name: 'Vue', slug: 'vue', badge: 'Script', href: '/docs/js' },
  { name: 'Svelte', slug: 'svelte', badge: 'Script', href: '/docs/js' },
  { name: 'HTML', slug: 'html', badge: 'Script', href: '/docs/js' },
];

const nocodeTools = [
  { name: 'Shopify', slug: 'shopify', badge: 'Script', href: '/docs/platforms/shopify' },
  { name: 'WordPress', slug: 'wordpress', badge: 'Plugin', href: '/docs/platforms/wordpress' },
  { name: 'Webflow', slug: 'webflow', badge: 'Script', href: '/docs/platforms/webflow' },
  { name: 'Framer', slug: 'framer', badge: 'Script', href: '/docs/platforms/framer' },
  { name: 'Carrd', slug: 'carrd', badge: 'Script', href: '/docs/platforms/carrd' },
  { name: 'Notion', slug: 'notion', badge: 'Script', href: '/docs/js' },
];

function badgeClasses(badge: string) {
  if (badge === 'SDK') return 'bg-accent-500/10 text-accent-500';
  if (badge === 'Plugin') return 'bg-purple-500/10 text-purple-600';
  return 'bg-[#F0F0F0] text-text-secondary';
}
---

<section class="bg-bg border-t border-border">
  <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:px-20">
    <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tight text-text-primary">
      Works everywhere.
    </h2>
    <p class="mt-3 text-base text-text-secondary max-w-lg leading-relaxed">
      One script tag works on any website. SDKs for React and Node.js. Native support for every major platform.
    </p>

    <div class="mt-10 md:mt-12 grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-10">
      <!-- Frameworks & SDKs -->
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-wider text-text-muted mb-3">
          Frameworks & SDKs
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          {codeFrameworks.map((f) => (
            <a
              href={f.href}
              class="flex items-center gap-3 border border-[#EBEBEB] hover:border-[#D0D0D0] hover:bg-bg-surface px-4 py-3 group no-underline transition-colors"
            >
              <img
                src={`/logos/${f.slug}.svg`}
                alt={f.name}
                class="h-5 w-5 shrink-0 object-contain"
              />
              <span class="text-sm font-semibold text-text-primary group-hover:text-accent-500 transition-colors flex-1">
                {f.name}
              </span>
              <span class:list={[
                "text-[10px] font-semibold uppercase tracking-wider px-1.5 py-0.5 shrink-0",
                badgeClasses(f.badge)
              ]}>
                {f.badge}
              </span>
            </a>
          ))}
        </div>
      </div>

      <!-- No-code & Low-code -->
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-wider text-text-muted mb-3">
          No-code & Low-code
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          {nocodeTools.map((f) => (
            <a
              href={f.href}
              class="flex items-center gap-3 border border-[#EBEBEB] hover:border-[#D0D0D0] hover:bg-bg-surface px-4 py-3 group no-underline transition-colors"
            >
              <img
                src={`/logos/${f.slug}.svg`}
                alt={f.name}
                class="h-5 w-5 shrink-0 object-contain"
              />
              <span class="text-sm font-semibold text-text-primary group-hover:text-accent-500 transition-colors flex-1">
                {f.name}
              </span>
              <span class:list={[
                "text-[10px] font-semibold uppercase tracking-wider px-1.5 py-0.5 shrink-0",
                badgeClasses(f.badge)
              ]}>
                {f.badge}
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
