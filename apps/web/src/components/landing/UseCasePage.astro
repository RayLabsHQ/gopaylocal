---
import { Button } from '../ui/button';
import FeaturesSection from './FeaturesSection.astro';
import FinalCTASection from './FinalCTASection.astro';
import type { UseCaseData } from '@/lib/use-case-data';

interface Props {
  data: UseCaseData;
}

const { data } = Astro.props;
---

<!-- Hero -->
<section class="pt-24 pb-16">
  <div class="max-w-7xl mx-auto px-6 md:px-20">
    <div class="flex items-center gap-2 mb-6">
      <span class="h-2 w-2 bg-accent-500 inline-block"></span>
      <span class="text-sm font-medium text-text-secondary">{data.tag}</span>
    </div>

    <h1 class="font-display text-4xl sm:text-5xl md:text-6xl font-bold tracking-[-2px] leading-[1.05] whitespace-pre-line">
      {data.headline}
    </h1>

    <p class="mt-6 text-base sm:text-lg text-text-secondary leading-[1.7] max-w-xl">
      {data.subline}
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-4">
      <Button href="https://app.gopaylocal.com" variant="primary" size="md" client:load>
        Start Free
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </Button>
      <Button href="https://docs.gopaylocal.com/getting-started/quickstart" variant="secondary" size="md" client:load>
        {data.secondaryCta}
      </Button>
    </div>
  </div>
</section>

<!-- Problem Grid -->
<section class="border-y border-border bg-bg-surface">
  <div class="max-w-7xl mx-auto px-6 py-24 md:px-20">
    <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tight leading-tight text-text-primary">{data.problem.title}</h2>
    <p class="mt-4 max-w-prose text-base text-text-secondary leading-relaxed">{data.problem.subtitle}</p>

    <div class="mt-12 grid grid-cols-2 gap-6 md:gap-0 md:grid-cols-4">
      {data.problem.columns.map((col, i) => (
        <div class:list={[
          i === 0 ? "md:pr-7" : "md:px-7 md:border-l border-border",
        ]}>
          <p class="font-display text-lg font-semibold leading-snug text-text-primary">{col.country}</p>
          <p class="mt-2 text-base text-text-secondary leading-relaxed tabular-nums">{col.context}</p>
          <p class:list={[
            "mt-3 font-display text-xl font-semibold leading-snug",
            col.positive ? "text-emerald-500" : "text-accent-text"
          ]}>
            {col.conversion}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Features -->
<FeaturesSection title={data.features.title} items={data.features.items} />

<!-- Category proof -->
<section class="bg-bg-inverted">
  <div class="max-w-7xl mx-auto px-6 py-20 md:px-20">
    <p class="font-display text-sm font-semibold uppercase tracking-wider text-text-inverted">{data.proof.label}</p>
    <p class="mt-4 max-w-2xl text-lg sm:text-xl text-text-secondary leading-relaxed">{data.proof.description}</p>
  </div>
</section>

<!-- Final CTA -->
<FinalCTASection title={data.cta.title} subtitle={data.cta.subtitle} dark={false} />
