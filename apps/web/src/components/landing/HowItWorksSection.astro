---
interface Props {
  title: string;
  subtitle: string;
  steps: { number: string; title: string; description: string }[];
}

const { title, subtitle, steps } = Astro.props;
---

<section class="border-y border-border bg-bg-surface">
  <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:px-20">
    <div class="mb-12">
      <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tight leading-tight text-text-primary">{title}</h2>
      <p class="mt-4 max-w-prose text-base text-text-secondary leading-relaxed">{subtitle}</p>
    </div>

    <div class="grid grid-cols-1 gap-8 md:gap-0 md:grid-cols-3">
      {steps.map((step, i) => (
        <div class:list={[
          i === 0 ? "md:pr-8" : "border-t md:border-t-0 md:border-l border-border pt-8 md:pt-0 md:px-8",
        ]}>
          <span class="font-display text-5xl font-bold text-accent-500 tracking-[-2px] tabular-nums">{step.number}</span>
          <h3 class="mt-4 font-display text-xl font-semibold leading-snug text-text-primary">{step.title}</h3>
          <p class="mt-3 max-w-prose text-base text-text-secondary leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
