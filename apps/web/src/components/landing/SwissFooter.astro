---
import Logo from './Logo.astro';

const footerColumns = [
  {
    title: 'Product',
    links: [
      { label: 'Pricing', href: '/#pricing' },
      { label: 'Integrations', href: '/#integrations' },
      { label: 'Live demo', href: '/demo' },
      { label: 'Compare', href: '/compare' },
      { label: 'Dashboard', href: 'https://app.gopaylocal.com' },
    ],
  },
  {
    title: 'Use cases',
    links: [
      { label: 'SaaS', href: '/use-cases/saas' },
      { label: 'Digital products', href: '/use-cases/digital-products' },
      { label: 'Online courses', href: '/use-cases/online-courses' },
      { label: 'Developer tools', href: '/use-cases/developer-tools' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Docs', href: 'https://docs.gopaylocal.com' },
      { label: 'Quickstart', href: 'https://docs.gopaylocal.com/getting-started/quickstart' },
      { label: 'API reference', href: 'https://docs.gopaylocal.com/api/authentication' },
      { label: 'Self-hosting', href: 'https://docs.gopaylocal.com/self-hosting/' },
      { label: 'GitHub', href: 'https://github.com/RayLabsHQ/gopaylocal' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Privacy', href: '/legal/privacy' },
      { label: 'Terms', href: '/legal/terms' },
    ],
  },
];
---

<footer class="border-t border-border">
  <div class="mx-auto max-w-7xl px-6 py-14 md:px-20 md:py-16">
    <div class="grid grid-cols-2 gap-10 md:grid-cols-5 md:gap-8">
      <div class="col-span-2 md:col-span-1">
        <Logo />
        <p class="mt-3 max-w-[28ch] text-sm leading-relaxed text-text-secondary">
          Country-fair pricing, applied automatically at the edge. Open source.
        </p>
      </div>

      {footerColumns.map((column) => (
        <nav>
          <h2 class="text-[11px] font-semibold uppercase tracking-wider text-text-muted">
            {column.title}
          </h2>
          <ul class="mt-4 space-y-3">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-text-secondary transition-colors hover:text-text-primary"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="mt-14 flex flex-col gap-2 border-t border-border pt-8 sm:flex-row sm:items-center sm:justify-between">
      <span class="text-[13px] text-text-muted tabular-nums">&copy; {new Date().getFullYear()} GoPayLocal</span>
      <span class="text-[13px] text-text-muted">Purchasing power parity pricing for global SaaS.</span>
    </div>
  </div>
</footer>
