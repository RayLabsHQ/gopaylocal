---
const integrations = [
  { name: 'Stripe', slug: 'stripe', desc: 'Coupons API' },
  { name: 'Paddle', slug: 'paddle', desc: 'Discounts API' },
  { name: 'LemonSqueezy', slug: 'lemonsqueezy', desc: 'Coupons API' },
  { name: 'Gumroad', slug: 'gumroad', desc: 'Offer codes' },
  { name: 'Chargebee', slug: 'chargebee', desc: 'Coupons API' },
  { name: 'Dodo', slug: 'dodo', desc: 'Discounts API' },
  { name: 'Polar', slug: 'polar', desc: 'Discounts API' },
  { name: 'Whop', slug: 'whop', desc: 'Promo codes' },
];
---

<section id="integrations" class="border-t border-border bg-bg">
  <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:px-20">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10 md:mb-12">
      <div>
        <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tight text-text-primary">
          Integrations
        </h2>
        <p class="mt-3 text-base text-text-secondary max-w-lg leading-relaxed">
          Works with every major payment platform. Discounts are auto-applied at checkout — no manual coupon entry.
        </p>
      </div>
      <a href="https://docs.gopaylocal.com" class="text-sm font-medium text-accent-500 hover:underline shrink-0">
        View all integrations →
      </a>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-0">
      {integrations.map((integration, i) => (
        <a
          href={`https://docs.gopaylocal.com/integrations/${integration.slug}`}
          class:list={[
            "group flex items-center gap-3 p-4 no-underline transition-colors",
            "border border-[#EBEBEB] hover:border-[#D0D0D0] hover:bg-bg-surface",
            "sm:border-0 sm:border-b sm:border-border sm:py-6 sm:px-0",
            i % 4 !== 0 && "sm:border-l sm:pl-6",
            i % 4 === 0 ? "sm:pr-6" : "sm:pr-6",
            i >= 4 && "sm:border-b-0",
          ]}
        >
          <img
            src={`/logos/${integration.slug}.svg`}
            alt={integration.name}
            class="h-8 w-8 sm:h-10 sm:w-10 shrink-0 object-contain"
          />
          <div class="min-w-0">
            <p class="font-display text-sm sm:text-base font-semibold text-text-primary group-hover:text-accent-500 transition-colors">
              {integration.name}
            </p>
            <p class="text-xs text-text-muted mt-0.5">{integration.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
