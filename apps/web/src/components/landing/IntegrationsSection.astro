---
// `slug` names the local logo/wordmark files; `docsSlug` overrides the docs
// URL where the docs page slug differs from the logo filename.
const integrations = [
  { name: 'Stripe', slug: 'stripe', desc: 'Coupons API', height: 'h-7 sm:h-9' },
  { name: 'Paddle', slug: 'paddle', desc: 'Discounts API', height: 'h-7 sm:h-8' },
  { name: 'Gumroad', slug: 'gumroad', desc: 'Offer codes', height: 'h-6 sm:h-7' },
  { name: 'Chargebee', slug: 'chargebee', desc: 'Coupons API', height: 'h-6 sm:h-7' },
  { name: 'Dodo', slug: 'dodo', docsSlug: 'dodo-payments', desc: 'Discounts API', height: 'h-7 sm:h-9', offset: '-translate-x-3' },
  { name: 'Polar', slug: 'polar', desc: 'Discounts API', height: 'h-7 sm:h-9' },
  { name: 'Whop', slug: 'whop', desc: 'Promo codes', height: 'h-5 sm:h-6' },
  { name: 'Creem', slug: 'creem', desc: 'Discount codes', height: 'h-6 sm:h-7' },
  { name: 'WooCommerce', slug: 'woocommerce', desc: 'Coupons API', height: 'h-6 sm:h-7' },
];
---

<section id="integrations" class="border-t border-border">
  <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:px-20">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10 md:mb-12">
      <div>
        <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tight leading-tight text-text-primary">
          Integrations
        </h2>
        <p class="mt-4 text-base text-text-secondary max-w-prose leading-relaxed">
          Works with {integrations.length} payment platforms. GoPayLocal creates the discount codes in your account; visitors copy the code from the banner, or your checkout applies it for them.
        </p>
      </div>
      <a href="https://docs.gopaylocal.com/integrations/overview" class="group/btn inline-flex items-center gap-2 bg-white text-[#0D0D0D] hover:opacity-90 px-5 py-2.5 text-sm font-semibold transition-opacity no-underline shrink-0">
        View all integrations
        <svg class="h-4 w-4 transition-transform duration-200 group-hover/btn:translate-x-1" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      {integrations.map((integration) => (
        <a
          href={`https://docs.gopaylocal.com/integrations/${integration.docsSlug ?? integration.slug}`}
          class="group flex flex-col gap-4 border border-border bg-bg-surface p-4 sm:p-6 no-underline transition-colors duration-200 hover:border-accent-500"
        >
          <div class="flex-1 flex items-end">
            <img
              src={`/logos/wordmarks/${integration.slug}.svg`}
              alt={integration.name}
              class={`${integration.height} w-full max-w-[140px] object-contain object-left ${integration.offset || ''}`}
            />
          </div>
          <p class="text-sm text-text-muted transition-colors duration-200 group-hover:text-text-secondary">{integration.desc}</p>
        </a>
      ))}
    </div>
  </div>
</section>
