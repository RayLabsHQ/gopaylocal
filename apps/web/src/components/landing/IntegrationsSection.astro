---
const integrations = [
  { name: 'Stripe', slug: 'stripe', desc: 'Coupons API', height: 'h-7 sm:h-9', glow: 'rgba(99,91,255,0.35)' },
  { name: 'Paddle', slug: 'paddle', desc: 'Discounts API', height: 'h-7 sm:h-8', glow: 'rgba(255,210,51,0.3)' },
  { name: 'LemonSqueezy', slug: 'lemonsqueezy', desc: 'Coupons API', height: 'h-6 sm:h-7', glow: 'rgba(252,197,21,0.3)' },
  { name: 'Gumroad', slug: 'gumroad', desc: 'Offer codes', height: 'h-6 sm:h-7', glow: 'rgba(255,144,163,0.3)' },
  { name: 'Chargebee', slug: 'chargebee', desc: 'Coupons API', height: 'h-6 sm:h-7', glow: 'rgba(255,102,0,0.3)' },
  { name: 'Dodo', slug: 'dodo', desc: 'Discounts API', height: 'h-7 sm:h-9', offset: '-translate-x-3', glow: 'rgba(107,203,55,0.3)' },
  { name: 'Polar', slug: 'polar', desc: 'Discounts API', height: 'h-7 sm:h-9', glow: 'rgba(0,145,255,0.3)' },
  { name: 'Whop', slug: 'whop', desc: 'Promo codes', height: 'h-5 sm:h-6', glow: 'rgba(255,71,71,0.3)' },
];
---

<section id="integrations" class="border-t border-border relative overflow-hidden">
  <!-- Background radial glow -->
  <div
    class="pointer-events-none absolute w-full h-full bg-linear-115 from-red-500/40 via-transparent via-5% md:via-10% -z-10"
  >
  </div>
  <div
    class="pointer-events-none absolute w-full h-full bg-linear-240 from-red-500/40 via-transparent via-5% md:via-10% -z-10"
  >
  </div>

  <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:px-20 relative">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10 md:mb-12">
      <div>
        <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tight text-text-primary">
          Integrations
        </h2>
        <p class="mt-3 text-base text-text-secondary max-w-lg leading-relaxed">
          Works with every major payment platform. Discounts are auto-applied at checkout — no manual coupon entry.
        </p>
      </div>
      <a href="https://docs.gopaylocal.com" class="group/btn inline-flex items-center gap-2 bg-white text-[#0D0D0D] hover:opacity-90 px-5 py-2.5 text-sm font-semibold transition-all no-underline shrink-0 rounded-lg">
        View all integrations
        <svg class="h-4 w-4 transition-transform duration-200 group-hover/btn:translate-x-1" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-0">
      {integrations.map((integration, i) => (
        <a
          href={`https://docs.gopaylocal.com/integrations/${integration.slug}`}
          class:list={[
            "integration-card group relative flex flex-col gap-3 p-4 no-underline transition-[color,background-color,border-color,box-shadow] duration-300",
            "border-0 sm:hover:bg-bg-surface",
            "sm:border-0 sm:border-b sm:border-border sm:py-6 sm:px-4",
            "sm:hover:shadow-none",
            i % 4 !== 0 && "sm:border-l sm:pl-6",
            i % 4 === 0 ? "sm:pr-6" : "sm:pr-6",
            i >= 4 && "sm:border-b-0",
          ]}
        >
          <!-- Brand-colored ambient glow -->
          <div class="absolute inset-0 pointer-events-none z-0" style={`background: linear-gradient(${i < 4 ? 'to top' : 'to bottom'}, ${integration.glow} 0%, transparent 70%);`}></div>

          <div class="flex-1 flex items-end relative z-10">
            <img
              src={`/logos/wordmarks/${integration.slug}.svg`}
              alt={integration.name}
              class={`${integration.height} w-full max-w-[140px] object-contain object-left ${integration.offset || ''}`}
            />
          </div>
          <p class="text-xs text-text-muted transition-colors duration-300 group-hover:text-text-secondary relative z-10">{integration.desc}</p>
        </a>
      ))}
    </div>
  </div>
</section>
