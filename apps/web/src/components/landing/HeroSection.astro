---
import { Button } from '../ui/button';
import { Badge } from '../ui/badge';
import { AsciiGlobe } from './ascii-globe';
import BannerPreview from './BannerPreview';
import type { HeroData } from '@/lib/landing-data';
import { integrations } from '@/lib/landing-data';

interface Props {
  data: HeroData;
}

const { data } = Astro.props;
---

<section class="pt-20 pb-16 md:pt-32 relative overflow-x-clip">


  <div class="max-w-7xl mx-auto px-6 md:px-20 relative">
    <!-- Two-column layout: content left, globe right -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:gap-12">
      <!-- Left column: text content -->
      <div class="flex-1 min-w-0">
        <Badge client:load>
          <span class="h-2 w-2 bg-accent-500 rounded-none inline-block"></span>
          {data.tag}
        </Badge>

        <h1 class="mt-6 font-display text-4xl font-bold tracking-[-2px] leading-[1] sm:text-5xl md:text-7xl lg:text-[80px] md:tracking-[-3px] whitespace-pre-line">
          {data.headline}
        </h1>

        <p class="mt-6 text-base sm:text-lg text-text-secondary leading-[1.7] max-w-xl">
          {data.subline}
        </p>

        {data.codeSnippet && (
          <div class="mt-8 max-w-xl border border-border bg-bg-surface px-5 py-5 sm:px-7 sm:py-6 space-y-1 overflow-x-auto">
            <p class="font-mono text-[13px] sm:text-sm text-text-muted">{'<!-- Add to your <head> — that\'s it -->'}</p>
            <p class="font-mono text-[13px] sm:text-sm text-text-primary">&lt;script</p>
            <p class="font-mono text-[13px] sm:text-sm text-accent-text pl-4">src="https://api.gopaylocal.com/v1/banner/script.js?key=gpl_pk_XXXX"</p>
            <p class="font-mono text-[13px] sm:text-sm text-emerald-500 pl-4">async</p>
            <p class="font-mono text-[13px] sm:text-sm text-text-primary">&gt;&lt;/script&gt;</p>
          </div>
        )}

        <div class="mt-8 flex flex-col sm:flex-row items-start sm:items-center gap-3 sm:gap-4">
          <Button href={data.primaryCta.href} variant="primary" size="md" client:load>
            {data.primaryCta.label}
            {data.primaryCta.icon === 'arrow-right' && (
              <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            )}
          </Button>
          <Button href={data.secondaryCta.href} variant="secondary" size="md" client:load>
            {data.secondaryCta.label}
          </Button>
        </div>
      </div>

      <!-- Right column: ASCII globe -->
      <div class="hidden lg:flex items-center justify-center shrink-0">
        <AsciiGlobe client:load />
      </div>
    </div>

    <!-- The production banner, rotating through default-campaign countries -->
    <div class="mt-12">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-text-muted mb-2">
        What your visitors see — <a href="/#demo" class="text-text-secondary hover:text-text-primary underline underline-offset-2 normal-case tracking-normal">try it live</a>
      </p>
      <BannerPreview client:load />
    </div>

    <!-- Stats -->
    <div class="mt-10 grid grid-cols-2 gap-6 sm:flex sm:gap-16 pt-10 relative border-t border-border">
      <!-- Flat red rule marking the start of the divider -->
      <div class="absolute -top-px left-0 h-[3px] w-10 bg-accent-500 pointer-events-none"></div>
      {data.stats.map((stat) => (
        <div>
          <div class:list={[
            "font-display text-3xl sm:text-4xl font-semibold tracking-tight tabular-nums",
            stat.accent ? "text-accent-500" : "text-text-primary"
          ]}>
            {stat.value}
          </div>
          <div class="text-sm text-text-secondary mt-1">{stat.label}</div>
        </div>
      ))}
    </div>

    <!-- Integrations -->
    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2">
      <span class="text-[11px] font-semibold uppercase tracking-wider text-text-muted shrink-0">Works with</span>
      {integrations.map((name) => (
        <span class="text-sm font-semibold text-text-secondary">{name}</span>
      ))}
    </div>
  </div>
</section>
