---
import SwissLayout from '../../layouts/SwissLayout.astro';
import ComparisonTable from '../../components/landing/ComparisonTable.astro';
import ComparisonSources from '../../components/landing/ComparisonSources.astro';
import FinalCTASection from '../../components/landing/FinalCTASection.astro';
import { COMPARISON_CHECKED_ON, CTA_SUBTITLE, competitorList, gopaylocalListing } from '@/lib/comparison-data';

const rows = [
  { label: 'GoPayLocal', cells: [gopaylocalListing.price, gopaylocalListing.calls, gopaylocalListing.openSource] },
  ...competitorList.map((c) => ({ label: c.name, cells: [c.listing.price, c.listing.calls, c.cells.openSource] })),
];
---

<SwissLayout
  title="GoPayLocal compared with other PPP pricing tools"
  description="How GoPayLocal compares with ParityDeals, ParityVend and Parity Kit on price, call limits and open source, with a page for each."
>
  <section class="pt-24 pb-16">
    <div class="max-w-7xl mx-auto px-6 md:px-20">
      <div class="flex items-center gap-2 mb-6">
        <span class="h-2 w-2 bg-accent-500 inline-block"></span>
        <span class="text-sm font-medium text-text-secondary">Comparisons, checked {COMPARISON_CHECKED_ON}</span>
      </div>
      <h1 class="font-display text-4xl sm:text-5xl md:text-6xl font-bold tracking-[-2px] leading-[1.05]">
        GoPayLocal and the other<br class="hidden sm:block" /> PPP pricing tools
      </h1>
      <p class="mt-6 text-base sm:text-lg text-text-secondary leading-[1.7] max-w-2xl">
        The same four facts for each product, then a page that goes through each one in detail, including the cases
        where the other product is the better choice.
      </p>
    </div>
  </section>

  <section class="border-y border-border bg-bg-surface">
    <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:px-20">
      <ComparisonTable
        caption="PPP pricing tools compared on price, calls and open source"
        corner="Product"
        columns={['Price', 'Calls a month', 'Open source']}
        emphasize={-1}
        rows={rows}
      />
    </div>
  </section>

  <section>
    <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:px-20">
      <div class="grid grid-cols-1 gap-x-12 gap-y-12 md:grid-cols-2">
        <div>
          <h2 class="font-display text-2xl font-semibold tracking-tight text-text-primary">Head to head</h2>
          <ul class="mt-6">
            {competitorList.map((c) => (
              <li class="border-t border-border py-5">
                <a href={`/vs/${c.slug}`} class="font-display text-lg font-semibold text-text-primary underline underline-offset-4">GoPayLocal vs {c.name}</a>
                <p class="mt-2 text-base text-text-secondary leading-relaxed">{c.differences[0]?.body}</p>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="font-display text-2xl font-semibold tracking-tight text-text-primary">Alternatives</h2>
          <ul class="mt-6">
            {competitorList.map((c) => (
              <li class="border-t border-border py-5">
                <a href={`/alternatives/${c.slug}`} class="font-display text-lg font-semibold text-text-primary underline underline-offset-4">{c.name} alternatives</a>
                <p class="mt-2 text-base text-text-secondary leading-relaxed">{c.whyLook[0]}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <ComparisonSources
    sources={competitorList
      .flatMap((c) => [{ label: c.sourceLabel, href: c.sourceUrl }, ...(c.extraSources ?? [])])
      .filter((source, index, all) => all.findIndex((other) => other.href === source.href) === index)}
  />

  <FinalCTASection
    title={`One paid plan.\nOpen source.`}
    subtitle={CTA_SUBTITLE}
    dark={false}
  />
</SwissLayout>
