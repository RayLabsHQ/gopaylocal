---
import SwissLayout from '../layouts/SwissLayout.astro';
import DemoSection from '../components/landing/DemoSection.astro';
import { Button } from '../components/ui/button';

const steps = [
  {
    number: '01',
    title: 'Edge geo-detection',
    description:
      'The script loads from the Cloudflare edge and reads the visitor country from the request. No IP database to maintain, no extra round trip to your server.',
  },
  {
    number: '02',
    title: 'Your rules decide',
    description:
      'The country is priced by your campaign’s pricing mode and capped at its maximum discount. VPN and datacenter traffic is filtered out before a discount is offered.',
  },
  {
    number: '03',
    title: 'Codes created for you',
    description:
      'The coupon is created in your payment provider — Stripe, Paddle, Gumroad, Chargebee, Dodo, Polar, Whop, Creem or WooCommerce — and reused on every later visit from that country.',
  },
];
---

<SwissLayout
  title="Live demo — GoPayLocal"
  description="Pick a country and see the exact banner your visitors would get, including the VPN case. No signup."
>
  <DemoSection
    as="h1"
    eyebrow="Demo"
    title="Try it as your customers see it"
    subtitle="A preview of the banner, using GoPayLocal's built-in discount tiers. Pick a country and the price changes with it."
  />

  <section class="bg-bg-surface">
    <div class="max-w-[1280px] mx-auto px-6 py-16 md:py-24 md:px-20">
      <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tight text-text-primary">
        How this works in production
      </h2>
      <p class="mt-4 text-lg text-text-secondary">Three moving parts, none of them yours to run.</p>

      <div class="mt-12 grid grid-cols-1 gap-8 md:gap-0 md:grid-cols-3">
        {steps.map((step, i) => (
          <div class:list={[
            i === 0 ? "md:pr-8" : "border-t md:border-t-0 md:border-l border-border pt-8 md:pt-0 md:px-8",
          ]}>
            <span class="font-display text-5xl font-bold text-accent-500 tracking-[-2px]">{step.number}</span>
            <h3 class="mt-4 font-display text-lg font-semibold text-text-primary">{step.title}</h3>
            <p class="mt-3 max-w-[62ch] text-sm text-text-secondary leading-relaxed">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-border py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-6 md:px-20 flex flex-col sm:flex-row items-start sm:items-center gap-4">
      <Button href="https://app.gopaylocal.com" variant="primary" size="md" client:load>
        Start free
      </Button>
      <Button
        href="https://docs.gopaylocal.com/getting-started/quickstart"
        variant="secondary"
        size="md"
        client:load
      >
        Read the docs
      </Button>
      <p class="text-sm text-text-secondary sm:ml-2">
        The Free plan is enough to run this on a live site.
      </p>
    </div>
  </section>
</SwissLayout>
