{
  // Typechecks the root-level TypeScript that no package owns: the Playwright
  // e2e suite and the Vitest/Playwright configs. Used by `pnpm typecheck`.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // e2e/support/seed-user.ts runs on Node's type stripping, which needs the
    // `.ts` extension in imports; it imports API source, hence workers-types.
    "allowImportingTsExtensions": true,
    "types": ["node", "@cloudflare/workers-types"]
  },
  "include": ["e2e/**/*.ts", "playwright.config.ts", "vitest.config.ts"]
}
